{
  "version": 2,
  "redirects": [
    {
      "source": "/",
      "destination": "/showcase.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/s/:cardId",
      "destination": "/api/view?id=:cardId"
    },
    {
      "source": "/index.html",
      "destination": "/suite.html"
    },
    {
      "source": "/everafter_add_7_template/(.*)",
      "destination": "/everafter_UI_UX_edit/$1"
    },
    {
      "source": "/everafter/(.*)",
      "destination": "/everafter_UI_UX_edit/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/everafter_UI_UX_edit/customize.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
