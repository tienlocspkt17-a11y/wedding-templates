{
  "version": 2,
  "redirects": [
    {
      "source": "/",
      "destination": "/showcase.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/s/:cardId",
      "destination": "/api/view?id=:cardId"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
